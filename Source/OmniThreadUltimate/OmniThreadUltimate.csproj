<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>OmniThreadUltimate</RootNamespace>
    <AssemblyName>OmniThreadUltimate</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath Condition="Exists('..\..\game\Mods\OmniThreadUltimate\Assemblies\')">..\..\game\Mods\OmniThreadUltimate\Assemblies\</OutputPath>
    <OutputPath Condition="!Exists('..\..\game\Mods\OmniThreadUltimate\Assemblies\')">..\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="OmniThreadMod.cs" />
    <Compile Include="MainThreadSyncQueue.cs" />
    <Compile Include="SpatialPartitioner.cs" />
    <Compile Include="ModCompatibilityManager.cs" />
    <Compile Include="ParallelTickEngine.cs" />
    <Compile Include="AutoBenchmarkRunner.cs" />
    <Compile Include="OmniThreadGUI.cs" />
  </ItemGroup>

  <!-- Local RimWorld Managed Assemblies (when building inside local workspace) -->
  <ItemGroup Condition="Exists('..\..\game\RimWorldWin64_Data\Managed\Assembly-CSharp.dll')">
